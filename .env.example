IGNEOUS_DATABASE_URL=postgresql+psycopg://igneous:igneous@localhost:5432/igneous
IGNEOUS_DATA_DIR=../data
# Comma-separated roots used by `igneous sync fs` when --path is omitted.
IGNEOUS_FILESYSTEM_ROOTS=/absolute/path/to/documents
# Q&A cross-encoder reranks graph-expanded evidence; false keeps graph retrieval order.
IGNEOUS_RERANKER_ENABLED=true
IGNEOUS_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
IGNEOUS_RERANKER_POOL_SIZE=32
# Drive list/change page size (1-1000).
IGNEOUS_DRIVE_PAGE_SIZE=100
NEXT_PUBLIC_API_URL=http://localhost:8000
# Provider selections. Local embeddings and reranking require no credentials.
IGNEOUS_EMBEDDING_PROVIDER=fastembed
IGNEOUS_RERANK_PROVIDER=cross_encoder
IGNEOUS_CHAT_PROVIDER=bedrock
IGNEOUS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Required only for explicit hosted calls (for example provider_smoke.py --hosted).
# AWS_BEARER_TOKEN_BEDROCK=...
# AWS_REGION=us-east-1
