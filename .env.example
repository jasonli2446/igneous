IGNEOUS_DATABASE_URL=postgresql+psycopg://igneous:igneous@localhost:5432/igneous
IGNEOUS_DATA_DIR=../data
# Comma-separated roots used by `igneous sync fs` when --path is omitted.
IGNEOUS_FILESYSTEM_ROOTS=/absolute/path/to/documents
# Ask's local cross-encoder scores the retrieved and graph-expanded passages and keeps the best 8; false keeps
# retrieval order with 3 of the 8 places held for graph neighbours.
IGNEOUS_RERANKER_ENABLED=true
IGNEOUS_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
IGNEOUS_RERANKER_POOL_SIZE=32
# Drive list/change page size (1-1000).
IGNEOUS_DRIVE_PAGE_SIZE=100
NEXT_PUBLIC_API_URL=http://localhost:8000
# Local embedding model (FastEmbed, no credentials), 384-dimensional. Changing it re-embeds every chunk on the next
# pipeline run.
IGNEOUS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Where FastEmbed keeps its downloaded models (default: <data_dir>/models).
# IGNEOUS_MODEL_CACHE_DIR=
# Required only for explicit hosted calls (for example provider_smoke.py --hosted).
# AWS_BEARER_TOKEN_BEDROCK=...
# AWS_REGION=us-east-1
# Automatic extraction never calls a hosted model until source IDs are explicitly listed.
# Example: IGNEOUS_LLM_SOURCES=email,gmail,ai_chats
# IGNEOUS_LLM_SOURCES=
